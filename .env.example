# Public Supabase values. The publishable key is intentionally browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://rgrlilmfjurdchcnxolt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only platform credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SARVAM_API_KEY=
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=
E2B_API_KEY=

# Provider and safety settings
SARVAM_MODEL=sarvam-105b
SARVAM_BASE_URL=https://api.sarvam.ai/v2
E2B_TEMPLATE=code-interpreter-v1
E2B_SANDBOX_TIMEOUT_MS=600000
E2B_PREVIEW_ACTIVE_SECONDS=600
FIRECRAWL_MAX_PAGES=5
GENERATION_MAX_OUTPUT_TOKENS=20000
GENERATION_MAX_REPAIRS=2
OPENROUTER_PLANNER_MODEL=google/gemini-3.8-flash
OPENROUTER_CREATE_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_EDIT_MODEL=anthropic/claude-sonnet-5.5
OPENROUTER_FALLBACK_MODELS=google/gemini-3.8-flash,anthropic/claude-sonnet-5.5
OPENROUTER_BATCH_OUTPUT_TOKENS=12000
OPENROUTER_REQUEST_TIMEOUT_MS=240000
OPENROUTER_MAX_COST_INR_PER_BUILD=75
USD_TO_INR_RATE=95
DAILY_BUILD_LIMIT=20
DAILY_MODEL_TOKEN_LIMIT=500000
DAILY_MODEL_COST_LIMIT_MINOR=10000
DAILY_FIRECRAWL_PAGE_LIMIT=25
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Use a {projectId} template so every generated app gets its own browser origin.
PREVIEW_ORIGIN=http://{projectId}.preview.localhost:3001
PREVIEW_GATEWAY_PORT=3001
# Required dedicated HMAC secret (32+ chars, different from every other key).
# Set the same value on the web app and the preview host. To rotate, move the
# old value to PREVIEW_SIGNING_SECRET_PREVIOUS for up to 6 hours.
PREVIEW_SIGNING_SECRET=
PREVIEW_SIGNING_SECRET_PREVIOUS=
WORKER_ID=local-worker

# Public site URL for canonical metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://www.nynz.in
# Set to "disabled" in tests/fixtures so no invitation or reset email is sent.
NYNZ_EMAIL_DELIVERY=

# Credits and cost accounting
PAISE_PER_CREDIT=100
TRIAL_CREDITS=25
RESERVE_PLAN_CREDITS=5
RESERVE_GENERATE_CREDITS=20
RESERVE_RESTART_CREDITS=3
# Optional JSON price overrides: {"model":{"in":0.000002,"out":0.00001}} (USD per token)
MODEL_PRICES_JSON=
E2B_COST_USD_PER_SECOND=0.000046
FIRECRAWL_COST_USD_PER_PAGE=0.00083
PREVIEW_IDLE_DAYS=7
# Optional: lets Admin -> Providers read the OpenRouter account balance.
OPENROUTER_MANAGEMENT_KEY=

# Payments (Razorpay). Test keys only until merchant, GSTIN and invoices are ready.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Live keys (rzp_live_) are refused unless this is "true".
BILLING_LIVE_ENABLED=false

# Publishing: wildcard site domain served by the preview/site host project.
PUBLISH_SITES_SUFFIX=
VERCEL_API_TOKEN=
PREVIEW_VERCEL_TOKEN=
PREVIEW_VERCEL_PROJECT_ID=
PREVIEW_VERCEL_TEAM_ID=
VERCEL_SITES_PROJECT_ID=
VERCEL_TEAM_ID=

# GitHub App (Contents: read and write only)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_STATE_SECRET=
