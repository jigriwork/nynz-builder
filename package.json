{
  "name": "nynz-builder",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm typecheck:preview",
    "typecheck:preview": "pnpm --dir preview-host exec tsc --noEmit",
    "test": "vitest run",
    "worker": "tsx scripts/worker.ts",
    "preview-gateway": "tsx scripts/preview-gateway.ts",
    "verify:integrations": "tsx scripts/verify-integrations.ts",
    "verify:supabase": "tsx scripts/verify-supabase.ts",
    "verify:live-build": "tsx scripts/verify-live-build.ts",
    "bootstrap:owner": "tsx scripts/bootstrap-owner.ts",
    "reconcile": "tsx scripts/reconcile.ts",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:brand",
    "check:brand": "tsx scripts/check-brand.ts",
    "notices": "tsx scripts/third-party-notices.ts",
    "verify:release": "tsx scripts/verify-release.ts",
    "verify:workspace": "tsx scripts/verify-workspace.ts",
    "stamp": "tsx scripts/stamp-build.ts",
    "deploy:web": "tsx scripts/stamp-build.ts && vercel --prod --yes",
    "test:concurrency": "bash scripts/test-concurrency.sh",
    "rehearse:resumable-migration": "bash scripts/rehearse-resumable-migration.sh"
  },
  "dependencies": {
    "@e2b/code-interpreter": "^2.9.0",
    "@mendable/firecrawl-js": "^4.3.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/typography": "^0.5.16",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.1",
    "e2b": "2.62.0",
    "framer-motion": "^12.23.12",
    "jszip": "^3.10.2",
    "lucide-react": "^0.532.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-syntax-highlighter": "^15.6.1",
    "tailwind-gradient-mask-image": "^1.2.0",
    "tsx": "^4.23.15",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/pg": "8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-syntax-highlighter": "15.5.13",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "pg": "8.13.1",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^13.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
